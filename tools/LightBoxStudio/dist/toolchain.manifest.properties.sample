# toolchain.manifest.properties（任意・上書き用）
#   dist/ に置くと、初回セットアップのダウンロード元/版を差し替えられる。
#   省略時は setup.jar 埋め込みの既定値（下記と同じ）を使う。Windows x64 前提。
#   tail = 展開後トップフォルダからの相対パス（実行ファイル/binの場所）。

# RISC-V GCC（xpack riscv-none-elf, RV32EC libgcc必須, 約360MB）
gcc.url=https://github.com/xpack-dev-tools/riscv-none-elf-gcc-xpack/releases/download/v14.2.0-3/xpack-riscv-none-elf-gcc-14.2.0-3-win32-x64.zip
gcc.tail=bin

# make（xpack windows-build-tools, 約2.7MB）
make.url=https://github.com/xpack-dev-tools/windows-build-tools-xpack/releases/download/v4.4.1-3/xpack-windows-build-tools-4.4.1-3-win32-x64.zip
make.tail=bin
make.exe=make.exe

# ch32fun SDK（master zip）
ch32fun.url=https://github.com/cnlohr/ch32fun/archive/refs/heads/master.zip
ch32fun.tail=ch32fun

# minichlink（公式プリビルド配布が無いため既定はURL空＝PC内の既存を自動検出コピー）
#   もし配布ZIPのURLがあれば指定するとDL展開する。
minichlink.url=
minichlink.exe=minichlink.exe

# ポータブルJRE（初回セットアップで「ポータブルJREも取得」を選んだ時のみ使用）
#   dist/runtime/ にのみ展開。システムには一切インストールしない（サンドボックス）。
#   Adoptium Temurin 17 LTS, Windows x64, インストーラ不要のzip。
jre.url=https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.13%2B11/OpenJDK17U-jre_x64_windows_hotspot_17.0.13_11.zip
